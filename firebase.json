{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/html; charset=UTF-8"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "fix.js",
      "update_portfolio_cards.py",
      "AGENTS.md",
      "README.md",
      "opencode.json",
      "docs/**",
      "graft/**",
      "scripts/**",
      "tests/**",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "content/**"
    ],
    "redirects": [
      {
        "source": "/PortfolioLuisGonzalez",
        "destination": "/",
